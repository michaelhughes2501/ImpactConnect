# Server-side OAuth credentials for the Google Integrations panel.
# Configure a single OAuth client at https://console.cloud.google.com/apis/credentials
# and add /integrations/callback (per environment) to the authorized redirect URIs.
# Enable the Classroom, Keep, Docs, and Forms APIs on the same Google Cloud project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Client-side env (Vite). Same client ID as above.
VITE_GOOGLE_OAUTH_CLIENT_ID=
