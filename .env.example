# Copy to .env. All values are optional for local development.
#
# Leave DATABASE_URL empty to run with the seeded in-memory store (no Postgres
# required) — the app boots and is fully usable locally. Set it to a real Neon/
# Postgres URL to use the Drizzle-backed storage layer.
DATABASE_URL=

# Session signing secret (only used when Replit Auth is enabled).
SESSION_SECRET=local_dev_secret_key

# Keep this placeholder to skip Replit OIDC and use the local mock session.
# Set a real Replit client id only when deploying on Replit.
REPL_ID=local-development-id

ISSUER_URL=https://replit.com/oidc
